{
    "name": "themeum/framework-example",
    "description": "Sample plugin that exercises themeum/framework in a real WordPress runtime.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Themeum",
            "email": "support@themeum.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "/var/www/html/framework-library",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=7.0",
        "themeum/framework": "*"
    },
    "require-dev": {
        "humbug/php-scoper": "^0.18.18",
        "symfony/finder": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Example\\": "src/"
        }
    },
    "scripts": {
        "scope": [
            "@php vendor/bin/php-scoper add-prefix --config=scoper.config.php --force",
            "@php scripts/post-scope-console-stubs.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
