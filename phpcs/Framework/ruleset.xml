<?xml version="1.0"?>
<ruleset name="Framework">
    <description>Framework custom coding standards.</description>

    <autoload>./autoload.php</autoload>

    <rule ref="Generic.Commenting.DocComment"/>

    <rule ref="Framework.NamingConventions.SnakeCaseMethod"/>
    <rule ref="Framework.NamingConventions.SnakeCaseVariable"/>
    <rule ref="Framework.NamingConventions.ScreamingSnakeCaseConstant"/>

    <rule ref="Framework.Visibility.NoPrivate"/>

    <rule ref="Framework.Files.FileDeclarationOrder"/>

    <rule ref="Framework.Commenting.FileDocblock"/>
    <rule ref="Framework.Commenting.RequiredMethodDocblock"/>
    <rule ref="Framework.Commenting.RequiredPropertyDocblock"/>
    <rule ref="Framework.Commenting.DocblockTagOrder"/>
</ruleset>
